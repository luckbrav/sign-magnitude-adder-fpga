# Normaliza as quebras de linha no repositorio.
# Sem isso, o Git no Windows grava CRLF no run_sim.sh e o script deixa de
# rodar no Linux/macOS com o erro "bad interpreter: No such file or directory".
* text=auto eol=lf

*.sh  text eol=lf
*.vhd text eol=lf
*.qsf text eol=lf
*.md  text eol=lf

*.webp binary
